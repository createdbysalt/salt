{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/**/template.tsx",
    "app/**/default.tsx",
    "middleware.ts"
  ],
  "project": ["app/**/*.{ts,tsx}", "packages/**/*.{ts,tsx}"],
  "ignore": [
    "**/_deprecated/**",
    "**/_archived/**",
    "**/archive/**",
    "node_modules_backup/**",
    "apps.old/**",
    "ralph-worktrees/**",
    ".next/**",
    "e2e/**",
    "supabase/functions/**",
    ".claude/**",
    "scripts/**"
  ],
  "ignoreDependencies": [
    "@types/*",
    "autoprefixer",
    "postcss",
    "prettier-plugin-tailwindcss",
    "turbo",
    "tsx",
    "shadcn",
    "opensrc",
    "@total-typescript/ts-reset"
  ],
  "ignoreBinaries": ["op"],
  "next": {
    "entry": [
      "app/**/page.tsx",
      "app/**/layout.tsx",
      "app/**/route.ts",
      "middleware.ts",
      "next.config.{js,ts,mjs}"
    ]
  }
}
