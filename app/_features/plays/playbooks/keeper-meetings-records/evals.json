{
  "playbook_slug": "keeper-meetings-records",
  "evals": [
    {
      "id": "calendar-cancelled-applies",
      "name": "Calendar cancellation marks meeting as cancelled",
      "input": {
        "title": "Discovery call",
        "signals": { "meeting_cancelled_by_calendar": true },
        "auto_apply_threshold": 90
      },
      "assertions": [
        { "type": "field_value_eq", "field": "status", "expected": "cancelled" },
        { "type": "field_status_eq", "field": "status", "expected": "applied" }
      ]
    },
    {
      "id": "attendance-evidence-completes",
      "name": "Attendance evidence marks meeting as completed",
      "input": {
        "title": "Weekly sync",
        "signals": { "meeting_has_attendance_evidence": true, "meeting_end_passed": true },
        "auto_apply_threshold": 90
      },
      "assertions": [
        { "type": "field_value_eq", "field": "status", "expected": "completed" },
        { "type": "field_status_eq", "field": "status", "expected": "applied" }
      ]
    },
    {
      "id": "meeting-type-inferred",
      "name": "Meeting type inferred from title and agenda",
      "input": {
        "title": "Kickoff - Acme Rebrand",
        "signals": { "inferred_meeting_type": "kickoff" },
        "auto_apply_threshold": 80
      },
      "assertions": [
        { "type": "field_value_eq", "field": "meeting_type", "expected": "kickoff" },
        { "type": "field_status_eq", "field": "meeting_type", "expected": "applied" }
      ]
    },
    {
      "id": "meeting-type-waits-below-threshold",
      "name": "Meeting type waits when threshold is higher",
      "input": {
        "title": "Quarterly review",
        "signals": { "inferred_meeting_type": "review" },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "meeting_type", "expected": "review" },
        { "type": "field_status_eq", "field": "meeting_type", "expected": "pending" }
      ]
    },
    {
      "id": "person-linked-by-attendee",
      "name": "Person linked when attendee email matches",
      "input": {
        "title": "Sync with Maya",
        "signals": {
          "meeting_attendee_email_match": true,
          "inferred_person_id": "person-maya123"
        },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "personId", "expected": "person-maya123" },
        { "type": "field_status_eq", "field": "personId", "expected": "applied" }
      ]
    },
    {
      "id": "org-linked-by-attendee",
      "name": "Organization linked when attendee email matches",
      "input": {
        "title": "Acme project kickoff",
        "signals": {
          "meeting_attendee_email_match": true,
          "inferred_organization_id": "org-acme123"
        },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "organizationId", "expected": "org-acme123" },
        { "type": "field_status_eq", "field": "organizationId", "expected": "applied" }
      ]
    },
    {
      "id": "work-linked-from-context",
      "name": "Work linked when meeting context matches work item",
      "input": {
        "title": "Website redesign check-in",
        "signals": { "inferred_work_id": "work-website123" },
        "auto_apply_threshold": 80
      },
      "assertions": [
        { "type": "field_value_eq", "field": "workId", "expected": "work-website123" },
        { "type": "field_status_eq", "field": "workId", "expected": "applied" }
      ]
    }
  ]
}
