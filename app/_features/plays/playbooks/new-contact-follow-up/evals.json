{
  "playbook_slug": "new-contact-follow-up",
  "evals": [
    {
      "id": "drafts-follow-up-for-new-contact",
      "name": "Drafts follow-up for new contact",
      "input": {
        "run": {
          "title": "Follow up with Sarah Chen",
          "context_inputs": {
            "person_name": "Sarah Chen",
            "person_email": "sarah@example.com",
            "context_notes": "Met at the design conference. Interested in collaboration."
          }
        }
      },
      "llmOutputs": {
        "draftBody": "Hi Sarah,\n\nIt was great meeting you at the conference! I'd love to continue our conversation about potential collaboration opportunities.\n\nLet me know if you'd like to grab coffee sometime."
      },
      "assertions": [
        {
          "type": "bound_exists",
          "bind": "emailDraft"
        },
        {
          "type": "bound_contains",
          "bind": "emailDraft",
          "substring": "Subject:"
        },
        {
          "type": "bound_contains",
          "bind": "emailDraft",
          "substring": "sarah@example.com"
        }
      ]
    },
    {
      "id": "skips-when-no-email",
      "name": "Skips when person has no email",
      "input": {
        "run": {
          "title": "Follow up with Unknown",
          "context_inputs": {
            "person_name": "Unknown Contact"
          }
        }
      },
      "assertions": [
        {
          "type": "guard_skipped"
        }
      ]
    }
  ]
}
