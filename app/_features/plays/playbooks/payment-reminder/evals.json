{
  "playbook_slug": "payment-reminder",
  "evals": [
    {
      "id": "drafts-reminder-for-overdue",
      "name": "Drafts reminder for overdue invoice",
      "input": {
        "run": {
          "title": "Payment reminder for Acme Corp",
          "context_inputs": {
            "invoice_number": "INV-2024-0042",
            "amount_due": 1500,
            "due_date": "2024-06-15",
            "client_name": "John Smith",
            "client_email": "john@acmecorp.com"
          }
        }
      },
      "llmOutputs": {
        "draftBody": "Hi John,\n\nI hope this message finds you well. I wanted to follow up on invoice INV-2024-0042 for $1,500, which was due on June 15th.\n\nIf you've already sent payment, please disregard this reminder. Otherwise, please let me know if you have any questions or if there's anything I can help with.\n\nThank you!"
      },
      "assertions": [
        {
          "type": "bound_exists",
          "bind": "emailDraft"
        },
        {
          "type": "bound_contains",
          "bind": "emailDraft",
          "substring": "INV-2024-0042"
        },
        {
          "type": "bound_contains",
          "bind": "emailDraft",
          "substring": "john@acmecorp.com"
        }
      ]
    },
    {
      "id": "skips-fully-paid",
      "name": "Skips when invoice is fully paid",
      "input": {
        "run": {
          "title": "Payment reminder for paid invoice",
          "context_inputs": {
            "invoice_number": "INV-2024-0043",
            "amount_due": 0,
            "due_date": "2024-06-20",
            "client_name": "Jane Doe",
            "client_email": "jane@example.com"
          }
        }
      },
      "assertions": [
        {
          "type": "guard_skipped"
        }
      ]
    }
  ]
}
