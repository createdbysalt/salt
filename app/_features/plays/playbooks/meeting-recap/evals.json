{
  "playbook_slug": "meeting-recap",
  "evals": [
    {
      "id": "transcript-produces-brief",
      "name": "Produces internal brief from transcript",
      "input": {
        "run": {
          "title": "Recap: Kickoff call"
        },
        "transcript": {
          "title": "Kickoff call",
          "summary": "Discussed scope and timeline."
        }
      },
      "mocks": {
        "FIREFLIES_GET_TRANSCRIPT": {
          "title": "Kickoff call",
          "summary": "Discussed scope and timeline."
        }
      },
      "assertions": [
        { "type": "bound_contains", "bind": "brief", "substring": "Kickoff call" },
        { "type": "bound_contains", "bind": "brief", "substring": "personalized" },
        { "type": "no_act_executed" }
      ]
    }
  ]
}
