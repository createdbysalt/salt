{
  "playbook_slug": "keeper-files-records",
  "evals": [
    {
      "id": "signature-sent-updates-lifecycle",
      "name": "Signature platform sent event updates lifecycle to sent",
      "input": {
        "file_name": "contract-v1.pdf",
        "signals": { "file_signature_event_sent": true },
        "auto_apply_threshold": 90
      },
      "assertions": [
        { "type": "field_value_eq", "field": "lifecycle_status", "expected": "sent" },
        { "type": "field_status_eq", "field": "lifecycle_status", "expected": "applied" }
      ]
    },
    {
      "id": "signature-viewed-updates-lifecycle",
      "name": "Signature platform viewed event updates lifecycle to viewed",
      "input": {
        "file_name": "contract-v1.pdf",
        "signals": { "file_signature_event_viewed": true },
        "auto_apply_threshold": 90
      },
      "assertions": [
        { "type": "field_value_eq", "field": "lifecycle_status", "expected": "viewed" },
        { "type": "field_status_eq", "field": "lifecycle_status", "expected": "applied" }
      ]
    },
    {
      "id": "signature-signed-updates-lifecycle",
      "name": "Signature platform signed event updates lifecycle to signed",
      "input": {
        "file_name": "contract-v1.pdf",
        "signals": { "file_signature_event_signed": true },
        "auto_apply_threshold": 90
      },
      "assertions": [
        { "type": "field_value_eq", "field": "lifecycle_status", "expected": "signed" },
        { "type": "field_status_eq", "field": "lifecycle_status", "expected": "applied" }
      ]
    },
    {
      "id": "signature-expired-updates-lifecycle",
      "name": "Signature platform expired event updates lifecycle to expired",
      "input": {
        "file_name": "contract-v1.pdf",
        "signals": { "file_signature_event_expired": true },
        "auto_apply_threshold": 90
      },
      "assertions": [
        { "type": "field_value_eq", "field": "lifecycle_status", "expected": "expired" },
        { "type": "field_status_eq", "field": "lifecycle_status", "expected": "applied" }
      ]
    },
    {
      "id": "category-inferred-applies",
      "name": "Inferred category applies at threshold",
      "input": {
        "file_name": "acme-contract-2026.pdf",
        "signals": { "inferred_category": "contract" },
        "auto_apply_threshold": 80
      },
      "assertions": [
        { "type": "field_value_eq", "field": "category", "expected": "contract" },
        { "type": "field_status_eq", "field": "category", "expected": "applied" }
      ]
    },
    {
      "id": "category-inferred-waits-below-threshold",
      "name": "Inferred category waits when threshold is higher",
      "input": {
        "file_name": "invoice-draft.pdf",
        "signals": { "inferred_category": "invoice" },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "category", "expected": "invoice" },
        { "type": "field_status_eq", "field": "category", "expected": "pending" }
      ]
    },
    {
      "id": "org-linked-by-source-context",
      "name": "Organization linked from source context",
      "input": {
        "file_name": "brand-guidelines.pdf",
        "signals": {
          "file_source_context_match": true,
          "inferred_organization_id": "org-acme123"
        },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "organizationId", "expected": "org-acme123" },
        { "type": "field_status_eq", "field": "organizationId", "expected": "applied" }
      ]
    },
    {
      "id": "person-linked-by-source-context",
      "name": "Person linked from source context",
      "input": {
        "file_name": "proposal.pdf",
        "signals": {
          "file_source_context_match": true,
          "inferred_person_id": "person-maya123"
        },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "personId", "expected": "person-maya123" },
        { "type": "field_status_eq", "field": "personId", "expected": "applied" }
      ]
    },
    {
      "id": "work-linked-from-context",
      "name": "Work linked when file context matches work item",
      "input": {
        "file_name": "deliverable-final.zip",
        "signals": { "inferred_work_id": "work-project123" },
        "auto_apply_threshold": 80
      },
      "assertions": [
        { "type": "field_value_eq", "field": "workId", "expected": "work-project123" },
        { "type": "field_status_eq", "field": "workId", "expected": "applied" }
      ]
    }
  ]
}
