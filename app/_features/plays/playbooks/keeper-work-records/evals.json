{
  "playbook_slug": "keeper-work-records",
  "evals": [
    {
      "id": "created-work-starts-active",
      "name": "Explicitly created work starts active",
      "input": {
        "name": "Website redesign",
        "signals": { "work_created": true },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "status", "expected": "active" },
        { "type": "field_status_eq", "field": "status", "expected": "applied" }
      ]
    },
    {
      "id": "signed-contract-classifies-signed",
      "name": "Signed contract evidence marks work as signed",
      "input": {
        "name": "Brand retainer",
        "signals": { "work_has_signed_contract": true },
        "auto_apply_threshold": 90
      },
      "assertions": [
        { "type": "field_value_eq", "field": "status", "expected": "signed" },
        { "type": "field_status_eq", "field": "status", "expected": "applied" }
      ]
    },
    {
      "id": "blocker-waits-below-threshold",
      "name": "Blocked status waits at the default threshold",
      "input": {
        "name": "Campaign launch",
        "signals": { "work_is_blocked": true },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "status", "expected": "on_hold" },
        { "type": "field_status_eq", "field": "status", "expected": "pending" }
      ]
    },
    {
      "id": "project-type-equality-applies",
      "name": "Direct project type applies when confidence equals threshold",
      "input": {
        "name": "Acme website",
        "signals": { "inferred_project_type": "Website" },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "project_type", "expected": "Website" },
        { "type": "field_status_eq", "field": "project_type", "expected": "applied" }
      ]
    },
    {
      "id": "description-waits-below-threshold",
      "name": "Description inference waits for review by default",
      "input": {
        "name": "Acme website",
        "signals": { "inferred_description": "Refresh the marketing site and launch pages." },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "description", "expected": "Refresh the marketing site and launch pages." },
        { "type": "field_status_eq", "field": "description", "expected": "pending" }
      ]
    },
    {
      "id": "deadline-exact-date-applies",
      "name": "Exact deadline applies at the default threshold",
      "input": {
        "name": "Acme launch",
        "signals": { "inferred_deadline": "2026-08-15" },
        "auto_apply_threshold": 85
      },
      "assertions": [
        { "type": "field_value_eq", "field": "deadline", "expected": "2026-08-15" },
        { "type": "field_status_eq", "field": "deadline", "expected": "applied" }
      ]
    }
  ]
}
