  "scripts": {
    "dev": "velite build && next dev --turbopack",
    "dev:op": "velite build && op run --env-file=.env.1password -- next dev --turbopack",
    "dev:staging:op": "velite build && op run --env-file=.env.staging.1password -- next dev --turbopack",
    "dev:staging:restart:op": "bash scripts/dev-staging-restart.sh",
    "research:op": "op run --env-file=.env.1password -- .claude/scripts/gemini-research.sh",
    "env:op-check": "op run --env-file=.env.1password -- bash -c '[[ -n \"$GEMINI_API_KEY\" ]] && echo OK: GEMINI_API_KEY || echo MISSING: GEMINI_API_KEY; [[ -n \"$GREPTILE_API_KEY\" ]] && echo OK: GREPTILE_API_KEY || echo MISSING: GREPTILE_API_KEY; [[ -n \"$PERPLEXITY_API_KEY\" ]] && echo OK: PERPLEXITY_API_KEY || echo MISSING: PERPLEXITY_API_KEY; [[ -n \"$COMPOSIO_API_KEY\" ]] && echo OK: COMPOSIO_API_KEY || echo MISSING: COMPOSIO_API_KEY; [[ -n \"$OPENROUTER_API_KEY\" ]] && echo OK: OPENROUTER_API_KEY || echo MISSING: OPENROUTER_API_KEY; [[ -n \"$APIFY_API_TOKEN\" ]] && echo OK: APIFY_API_TOKEN || echo MISSING: APIFY_API_TOKEN; [[ -n \"$APIFY_TOKEN\" ]] && echo OK: APIFY_TOKEN || echo MISSING: APIFY_TOKEN; [[ -n \"$BRANDFETCH_API_KEY\" ]] && echo OK: BRANDFETCH_API_KEY || echo MISSING: BRANDFETCH_API_KEY; [[ -n \"$BRANDFETCH_CLIENT_ID\" ]] && echo OK: BRANDFETCH_CLIENT_ID || echo MISSING: BRANDFETCH_CLIENT_ID; code=$(curl -sS -o /dev/null -w \"%{http_code}\" -H \"Authorization: Bearer $APIFY_API_TOKEN\" https://api.apify.com/v2/users/me); if [[ \"$code\" == \"200\" ]]; then echo OK: apify-api-auth; else echo FAIL: apify-api-auth HTTP $code — rotate token in Apify Console and 1Password item apify; fi; if [[ -n \"$BRANDFETCH_API_KEY\" && -n \"$BRANDFETCH_CLIENT_ID\" ]]; then bf=$(curl -sS -X POST \"https://mcp.brandfetch.io/mcp?apiKey=$BRANDFETCH_API_KEY&clientId=$BRANDFETCH_CLIENT_ID\" -H \"Content-Type: application/json\" -H \"Accept: application/json, text/event-stream\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"method\\\":\\\"initialize\\\",\\\"params\\\":{\\\"protocolVersion\\\":\\\"2024-11-05\\\",\\\"capabilities\\\":{},\\\"clientInfo\\\":{\\\"name\\\":\\\"salt-env-check\\\",\\\"version\\\":\\\"1.0.0\\\"}}}\"); if echo \"$bf\" | grep -q brandfetch-mcp-server; then echo OK: brandfetch-mcp-auth; else echo FAIL: brandfetch-mcp-auth — check API key and client ID in 1Password item brandfetch; fi; fi'",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "lint:findings": "tsx scripts/lint-findings-usage.ts",
    "typecheck": "velite build && next typegen && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check:no-daisyui": "bash scripts/check-no-daisyui.sh",
    "check:brand-drift": "bash scripts/check-brand-drift.sh",
    "check:doc-drift": "bash scripts/check-doc-drift.sh",
    "check:migrations": "tsx scripts/check-migration-grants.mts",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "coverage:fields": "tsx scripts/generate-field-coverage.ts",
    "waitlist:report": "tsx scripts/waitlist-conversion-report.ts",
    "waitlist:report:op": "op run --env-file=.env.1password -- tsx scripts/waitlist-conversion-report.ts",
    "waitlist:resend-sync": "tsx scripts/waitlist-resend-audience-sync.ts",
    "waitlist:resend-sync:op": "op run --env-file=.env.1password -- tsx scripts/waitlist-resend-audience-sync.ts",
