{
  "name": "salt-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check:no-daisyui": "bash scripts/check-no-daisyui.sh",
    "seed:test-users": "npx tsx scripts/seed-test-users.ts",
    "stripe:setup-products": "npx tsx scripts/stripe-setup-products.ts",
    "stripe:webhooks": "bash scripts/stripe-webhooks.sh",
    "test:e2e:legacy": "playwright test",
    "test:e2e:legacy:ui": "playwright test --ui",
    "test:e2e:legacy:debug": "playwright test --debug",
    "test:e2e": "cd e2e && playwright test",
    "test:e2e:ui": "cd e2e && playwright test --ui",
    "test:e2e:debug": "cd e2e && playwright test --debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test && pnpm test:e2e",
    "clean": "rm -rf .next node_modules/.cache .turbo coverage"
  },
  "dependencies": {
