{
  "name": "usesalt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:op": "op run --env-file=.env.1password -- next dev",
    "research:op": "op run --env-file=.env.1password -- .claude/scripts/gemini-research.sh",
    "env:op-check": "op run --env-file=.env.1password -- bash -c '[[ -n \"$GEMINI_API_KEY\" ]] && echo OK: GEMINI_API_KEY || echo MISSING: GEMINI_API_KEY; [[ -n \"$GREPTILE_API_KEY\" ]] && echo OK: GREPTILE_API_KEY || echo MISSING: GREPTILE_API_KEY; [[ -n \"$PERPLEXITY_API_KEY\" ]] && echo OK: PERPLEXITY_API_KEY || echo MISSING: PERPLEXITY_API_KEY; [[ -n \"$APIFY_API_TOKEN\" ]] && echo OK: APIFY_API_TOKEN || echo MISSING: APIFY_API_TOKEN; [[ -n \"$APIFY_TOKEN\" ]] && echo OK: APIFY_TOKEN || echo MISSING: APIFY_TOKEN; code=$(curl -sS -o /dev/null -w \"%{http_code}\" -H \"Authorization: Bearer $APIFY_API_TOKEN\" https://api.apify.com/v2/users/me); if [[ \"$code\" == \"200\" ]]; then echo OK: apify-api-auth; else echo FAIL: apify-api-auth HTTP $code — rotate token in Apify Console and 1Password item apify; fi'",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check:no-daisyui": "bash scripts/check-no-daisyui.sh",
    "check:brand-drift": "bash scripts/check-brand-drift.sh",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "stripe:setup-products": "tsx scripts/stripe-setup-products.ts",
    "stripe:webhooks": "bash scripts/stripe-webhooks.sh",
    "test:e2e:legacy": "playwright test",
    "test:e2e:legacy:ui": "playwright test --ui",
    "test:e2e:legacy:debug": "playwright test --debug",
    "test:e2e": "cd e2e && playwright test",
    "test:e2e:ui": "cd e2e && playwright test --ui",
    "test:e2e:debug": "cd e2e && playwright test --debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test && pnpm test:e2e",
    "clean": "rm -rf .next node_modules/.cache .turbo coverage",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
