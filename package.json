    "playbooks:check-live": "tsx scripts/validate-playbooks.ts --live",
    "playbooks:backfill-selections": "tsx scripts/backfill-app-selections.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test && pnpm test:e2e",
    "clean": "rm -rf .next node_modules/.cache .turbo coverage",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "content:seed-blog-categories": "tsx scripts/seed-blog-categories-sanity.ts",
    "content:seed-blog-categories:op": "op run --env-file=.env.1password -- tsx scripts/seed-blog-categories-sanity.ts",
