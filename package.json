    "content:seed-compare:op": "op run --env-file=.env.1password -- tsx scripts/seed-compare-sanity.ts",
    "content:seed-features": "tsx scripts/seed-features-sanity.ts",
    "content:seed-features:op": "op run --env-file=.env.1password -- tsx scripts/seed-features-sanity.ts",
