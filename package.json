    "content:cleanup-author-duplicates": "tsx scripts/cleanup-duplicate-sanity-authors.ts",
    "content:cleanup-author-duplicates:op": "op run --env-file=.env.1password -- tsx scripts/cleanup-duplicate-sanity-authors.ts",
    "content:extract-blog-markdown": "tsx scripts/extract-learn-article-markdown.ts",
    "content:seed-core-pages": "tsx scripts/seed-core-pages-sanity.ts",
    "content:seed-core-pages:op": "op run --env-file=.env.1password -- tsx scripts/seed-core-pages-sanity.ts",
    "content:seed-legal-pages": "tsx scripts/seed-legal-pages-sanity.ts",
    "content:seed-legal-pages:op": "op run --env-file=.env.1password -- tsx scripts/seed-legal-pages-sanity.ts",
    "content:seed-landing-icp-template": "tsx scripts/seed-landing-icp-template-sanity.ts",
    "content:seed-landing-icp-template:op": "op run --env-file=.env.1password -- tsx scripts/seed-landing-icp-template-sanity.ts",
    "content:seed-segment-landings": "tsx scripts/seed-segment-landings-sanity.ts",
    "content:seed-segment-landings:op": "op run --env-file=.env.1password -- tsx scripts/seed-segment-landings-sanity.ts",
    "content:seed-form-blog-newsletter": "tsx scripts/seed-form-blog-newsletter-sanity.ts",
    "content:seed-form-blog-newsletter:op": "op run --env-file=.env.1password -- tsx scripts/seed-form-blog-newsletter-sanity.ts"
