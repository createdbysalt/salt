{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base Config - Salt Core",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,

    "sourceMap": true,

    "noEmit": true,
    "incremental": true
  },
  "exclude": [
    "node_modules",
    "node_modules_backup",
    "dist",
    "build",
    ".next",
    "coverage",
    "archive",
    "apps.old",
    "velite.config.js"
  ]
}
