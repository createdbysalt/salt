{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/.velite": ["./.velite"],
      "@repo/utils": ["./packages/utils/src"],
      "@repo/shared-types": ["./packages/shared-types/src"],
      "@repo/theme": ["./packages/theme/src"],
      "@repo/security": ["./packages/security/src"],
      "@repo/ui": ["./packages/ui/src"],
      "@repo/patterns": ["./packages/patterns/src"],
      "@repo/logger": ["./packages/logger/src"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules_backup",
    "archive",
    "apps.old",
    "e2e",
    "ralph-worktrees",
    "velite.config.ts",
    "velite.config.js",
    "velite.config.mjs",
    "scripts",
    "supabase/functions",
    "**/_deprecated",
    "_archived"
  ]
}
