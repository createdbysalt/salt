# -----------------------------------------------------------------------------
# Supabase: https://supabase.com/docs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App URLs (for multi-domain setup)
# -----------------------------------------------------------------------------
# Bridge (client portal) URL
# Production: https://bridge.saltcore.io
# Development: http://localhost:3000/bridge
NEXT_PUBLIC_BRIDGE_URL=http://localhost:3000/bridge

# Main app URL (optional, for studio dashboard)
# Production: https://app.saltcore.io
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe: https://stripe.com/docs
# IMPORTANT: Use TEST mode keys only (pk_test_* and sk_test_*)
# Live keys are not permitted in this sandbox environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook secrets - get these from `npm run stripe:webhooks` output
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend (Email): https://resend.com/docs
# -----------------------------------------------------------------------------
RESEND_API_KEY=
