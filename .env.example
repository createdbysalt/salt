# -----------------------------------------------------------------------------
# Supabase: https://supabase.com/docs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Analytics (GTM + PostHog + Meta CAPI)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Optional overrides (defaults are wired in app/_lib/analytics/config.ts)
# NEXT_PUBLIC_GTM_ID=GTM-PP88BWLJ
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# NEXT_PUBLIC_META_PIXEL_ID=4225942947736078
META_CAPI_TOKEN=

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Enable password-based dev login endpoint (for E2E testing)
# Set to "true" ONLY in development environments
ENABLE_DEV_LOGIN=true

# -----------------------------------------------------------------------------
# Deployment environment (Vercel branch targeting)
# See docs/guides/deployment-environments.md
# -----------------------------------------------------------------------------
# production | staging | development
# Set per Vercel branch: staging branch → staging
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Product sign-in + app surfaces (waitlist launch)
# true = allow /signin and /hq (set on staging branch)
# false = redirect to /waitlist (production during early access)
# unset = auto: staging + local dev allow; production + Vercel previews block
# NEXT_PUBLIC_PRODUCT_AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# App URLs (for multi-domain setup)
# -----------------------------------------------------------------------------
# Marketing site
# Production: https://usesalt.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Main app URL
# Production: https://app.usesalt.io
# Staging: https://app.staging.usesalt.io
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy bridge URL (retired surface — avoid new usage)
NEXT_PUBLIC_BRIDGE_URL=http://localhost:3000/bridge

# -----------------------------------------------------------------------------
# Stripe: https://stripe.com/docs
# IMPORTANT: Use TEST mode keys only (pk_test_* and sk_test_*)
# Live keys are not permitted in this sandbox environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook secrets - get these from `pnpm stripe:webhooks` output
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend (Email): https://resend.com/docs
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Resend Dashboard → Audiences → create "Waitlist" → copy audience ID
RESEND_WAITLIST_AUDIENCE_ID=
# Leave unset/false until emails 5+ are approved for send (cron + batch)
WAITLIST_NURTURE_POST_EMAIL_4_ENABLED=
# Comma-separated team inboxes notified on each new completed waitlist signup
WAITLIST_NOTIFY_EMAIL=

# -----------------------------------------------------------------------------
# AI Agents (Claude Code MCP Servers)
# These support AI agent workflows in .claude/agents/ and MCP servers in .mcp.json
# -----------------------------------------------------------------------------
# Gemini API key for /research command (pre-build research intelligence)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Firecrawl API key for LLM-ready web scraping, site crawls, PDF parsing
# Get from: https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Apify API token for X/Twitter and Reddit scraping
# Get from: Apify Console → Integrations
APIFY_API_TOKEN=
# Same token — required by @apify/actors-mcp-server (stdio MCP)
APIFY_TOKEN=

# Greptile API key for PR review MCP in Cursor / Claude Code (.mcp.json)
# Get from: https://app.greptile.com/settings/organization/api
GREPTILE_API_KEY=

# -----------------------------------------------------------------------------
# Sanity CMS (Marketing Site)
# Required for Sanity Studio (/edit) and blog post content operations.
# Get from: 1Password vault salt-software-development, item "sanity"
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Google OAuth (Gmail & Calendar)
# Required for Gmail/Calendar integrations
# Get from: Google Cloud Console → APIs → Credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Gmail Integration (Reply Capture)
# Required for receiving Gmail replies via push notifications
# -----------------------------------------------------------------------------
# Encryption key for Gmail tokens (generate with: openssl rand -hex 32)
GMAIL_ENCRYPTION_KEY=
# Google Cloud Pub/Sub topic for Gmail push notifications
# Format: projects/{project-id}/topics/{topic-name}
GMAIL_PUBSUB_TOPIC=
# OIDC audience for Pub/Sub push (full webhook URL)
GMAIL_PUBSUB_PUSH_AUDIENCE=
# Expected Google service account email on push JWT (optional)
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Dev only: skip OIDC verification for local Pub/Sub testing
GMAIL_PUBSUB_SKIP_VERIFICATION=
# Recall calendar webhooks (Svix signing secret)
RECALL_CALENDAR_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Calendar Integration
# Required for calendar sync features
# -----------------------------------------------------------------------------
# Encryption key for Calendar tokens (generate with: openssl rand -hex 32)
CALENDAR_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Cal.com Integration (Optional)
# Required for meeting booking features
# Get from: app.cal.com/settings/developer/oauth-clients
# -----------------------------------------------------------------------------
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Composio (Gmail, Google Calendar integrations)
# Get from: https://platform.composio.dev
# Entity ID strategy: studio_id (see app/_lib/composio/connections.ts)
# -----------------------------------------------------------------------------
COMPOSIO_API_KEY=

# -----------------------------------------------------------------------------
# OpenRouter (primary LLM routing — see app/_lib/ai/models.ts)
# Fallback: OPENAI_API_KEY when OpenRouter unavailable
# Get from: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional per-workload overrides (OpenRouter model slugs)
# AI_MODEL_INSIGHTS=openai/gpt-4o-mini
# AI_MODEL_EXTRACTION=openai/gpt-4o
# AI_MODEL_SUMMARIZATION=openai/gpt-4o
# AI_MODEL_MEETING=openai/gpt-4o
# AI_MODEL_OPPORTUNITY=anthropic/claude-sonnet-4
# AI_MODEL_PLAY_DRAFT=anthropic/claude-sonnet-4
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
