{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"staging\" ]; then exit 1; else exit 0; fi",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true,
      "dependabot/**": false,
      "agent/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/waitlist-nurture",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/purge-trash",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/connector-catalog-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/capture-reconciliation",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/signal-scan",
      "schedule": "0 */2 * * *"
    }
  ]
}
